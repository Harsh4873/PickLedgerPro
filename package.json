{
  "name": "harsh-bet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "cp .nojekyll CNAME dist/",
    "upcheck": "npm run build && python3 scripts/site_upcheck.py",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/today/*.test.ts && python3 -m pytest tests/smoke -q"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
